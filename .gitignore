node_modules/
build/
.adonisjs/
coverage/
.nyc_output/
.env
*.log
.claude
CLAUDE.md
cmultitenancy-packagetestsunitadmin
# VitePress build output (the markdown under docs/ IS tracked)
docs/.vitepress/cache/
docs/.vitepress/dist/

# Benchmark run output (raw result JSON). Committed baselines live in
# benchmarks/baselines/ and are tracked; per-run results are not.
benchmarks/results/

# Temp dir for the docs code-fence import gate (scripts/check-docs-code.mjs)
.docs-code-tmp/

# VitePress generated output only. The theme source under docs/.vitepress/theme/
# IS tracked; a blanket `docs/.vitepress/` rule silently drops any NEW theme file
# (existing ones survive only because git ignores untracked files, not tracked ones).
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/*.timestamp-*.mjs

# doc-coverage: the graph is generated, never committed (RFC §5). The cache is
# keyed by a src+docs content hash and is always safe to delete.
doc-graph.json
.doc-coverage-cache/

# api-extractor scratch (the committed golden is etc/<pkg>.api.md; temp/ is not).
packages/*/temp/

# Private WIP: the lasagna-ai design docs stay local until they are ready to
# publish. The rest of packages/ai/ is tracked normally; remove these lines to
# publish the docs.
packages/ai/ARCHITECTURE.md
packages/ai/SEAMS.md

# Data-protection satellite ARCHITECTURE docs are kept local (the design bundle in design/ is the tracked source).
packages/crypto/ARCHITECTURE.md
