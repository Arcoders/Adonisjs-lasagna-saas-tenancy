{{{
  exports({ to: app.makePath('resources/views/emails/quota_warning.edge') })
}}}
<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Quota warning</title>
  </head>
  <body style="font-family: system-ui, sans-serif; line-height: 1.5; color: #1f2933;">
    <h1 style="margin-top: 0;">You're hitting your {{ '{{' }} quota }} limit</h1>

    <p>Hi {{ '{{' }} tenantName }},</p>

    <p>
      Your account has used
      <strong>{{ '{{' }} current }} / {{ '{{' }} limit }}</strong>
      {{ '{{' }} quota }} this period.
      The latest request would have pushed you to
      {{ '{{' }} current + attempted }} — over your plan's limit, so it was rejected.
    </p>

    <p>
      Upgrade to keep going, or wait for the counter to reset at the start of
      the next period.
    </p>

    <p style="margin-top: 24px;">
      <a
        href="https://example.com/settings/billing"
        style="background:#2563eb;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;display:inline-block;"
      >Manage billing</a>
    </p>

    <p style="color:#52606d;font-size:12px;margin-top:32px;">
      You're receiving this because someone in your team triggered a quota
      ceiling. We'll only send this once per day per limit.
    </p>
  </body>
</html>
