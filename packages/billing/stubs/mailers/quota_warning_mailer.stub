{{{
  exports({ to: app.makePath('app/mailers/quota_warning_mailer.ts') })
}}}
import { BaseMail } from '@adonisjs/mail'
import type { TenantModelContract } from '@adonisjs-lasagna/saas-tenancy/types'

interface QuotaWarningPayload {
  tenant: TenantModelContract
  quota: string
  limit: number
  current: number
  attempted: number
}

/**
 * Sent by \`QuotaExceededBillingListener\` when a tenant trips a hard quota
 * AND \`config.billing.notifyOnQuotaExceeded === true\`.
 *
 * Customise:
 *   - swap the subject / from address below
 *   - replace \`resources/views/emails/quota_warning.edge\` with branded markup
 *   - read \`this.payload.tenant\` for tenant-aware tokens (name, plan, etc.)
 *
 * The listener dedupes via Redis SETNX with 24h TTL — you won't get a
 * second mail for the same (tenant, quota) within a day.
 */
export default class QuotaWarningMailer extends BaseMail {
  payload!: QuotaWarningPayload

  prepare() {
    const { tenant, quota, limit, current, attempted } = this.payload

    this.message
      .to(tenant.email)
      .subject(\`You're hitting your \${quota} limit\`)
      .htmlView('emails/quota_warning', {
        tenantName: tenant.name,
        quota,
        limit,
        current,
        attempted,
      })
  }
}
