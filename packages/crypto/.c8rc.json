{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.d.ts",
    "src/define_config.ts",
    "src/types/**",
    "src/services/wrapped_dek_store.ts",
    "src/index.ts",
    "src/events/**",
    "src/sdk/**",
    "src/commands/**",
    "src/internal/operation_lock.ts",
    "build/**",
    "bin/**",
    "tests/**"
  ],
  "reporter": ["text-summary", "lcov"],
  "report-dir": "./coverage",
  "clean": true,
  "check-coverage": true,
  "statements": 91,
  "branches": 85,
  "functions": 90,
  "lines": 91
}
