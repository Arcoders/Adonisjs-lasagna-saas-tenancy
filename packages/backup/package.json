{
  "name": "@adonisjs-lasagna/backup",
  "version": "0.1.0",
  "description": "Per-tenant backup, restore, clone, SQL import and retention for @adonisjs-lasagna/saas-tenancy (pg_dump/pg_restore, optional S3, the tenant:backup* / tenant:clone / tenant:import ace commands, and a doctor backup-recency check)",
  "type": "module",
  "license": "MIT",
  "author": "Ismael Haytam Tanane",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy.git",
    "directory": "packages/backup"
  },
  "bugs": {
    "url": "https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy/issues"
  },
  "keywords": [
    "adonisjs",
    "saas-tenancy",
    "multitenancy",
    "backup",
    "restore",
    "clone"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/src/index.js",
    "./provider": "./build/providers/backup_provider.js",
    "./commands": "./build/src/commands/main.js"
  },
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "adonisjs": {
    "commands": [
      "./build/src/commands/main.js"
    ]
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/commands/commands.json','build/src/commands/commands.json')\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx bin/test.ts"
  },
  "peerDependencies": {
    "@adonisjs-lasagna/saas-tenancy": "^1.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/queue": "^0.6.0",
    "@adonisjs/redis": "^10.0.0",
    "@aws-sdk/client-s3": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/redis": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    }
  }
}
