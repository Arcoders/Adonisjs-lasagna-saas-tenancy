{
  "name": "@adonisjs-lasagna/rental-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Karimoto — a real car-rental SaaS built on @adonisjs-lasagna/* exercising every capability of the platform",
  "imports": {
    "#config/*": "./config/*.js",
    "#app/*": "./app/*.js",
    "#start/*": "./start/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js"
  },
  "scripts": {
    "ace": "tsx ace.ts",
    "dev": "tsx ace.ts serve",
    "dev:worker": "tsx ace.ts queue:work",
    "start": "node --import=@poppinss/ts-exec bin/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx ace.ts test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v",
    "setup": "tsx ace.ts backoffice:setup && tsx ace.ts migration:run --connection=public && tsx ace.ts rental:seed",
    "setup:demo": "tsx ace.ts tenant:vector:provision && tsx ace.ts migration:tenant:run && tsx ace.ts rental:seed:demo",
    "seed:demo": "tsx ace.ts rental:seed:demo"
  },
  "dependencies": {
    "@adonisjs-lasagna/saas-tenancy": "*",
    "@adonisjs-lasagna/admin": "*",
    "@adonisjs-lasagna/ai": "*",
    "@adonisjs-lasagna/crypto": "*",
    "@adonisjs-lasagna/billing": "*",
    "@adonisjs-lasagna/sso": "*",
    "@adonisjs-lasagna/backup": "*",
    "@adonisjs-lasagna/websockets": "*",
    "@adonisjs-lasagna/reporting": "*",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.2.0",
    "@adonisjs/queue": "^0.6.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/vite": "^5.1.1",
    "@inertiajs/react": "^2.3.27",
    "@poppinss/ts-exec": "^1.4.4",
    "@vinejs/vine": "^4.1.0",
    "edge.js": "^6.4.0",
    "jose": "^6.0.0",
    "luxon": "^3.0.0",
    "pg": "^8.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.0",
    "socket.io": "^4.8.0",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.0.0",
    "@japa/runner": "^4.2.0",
    "@types/luxon": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0",
    "vite": "^7.3.6"
  }
}
