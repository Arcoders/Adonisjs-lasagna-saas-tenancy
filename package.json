{
  "name": "@adonisjs-lasagna/saas-tenancy-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @adonisjs-lasagna/saas-tenancy (core) and its satellite packages (sso, billing, admin, backup)",
  "type": "module",
  "license": "MIT",
  "author": "Ismael Haytam Tanane",
  "homepage": "https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy.git"
  },
  "bugs": {
    "url": "https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/api",
    "benchmarks"
  ],
  "scripts": {
    "build": "npm run build --workspace @adonisjs-lasagna/saas-tenancy",
    "build:sso": "npm run build --workspace @adonisjs-lasagna/sso",
    "build:billing": "npm run build --workspace @adonisjs-lasagna/billing",
    "build:admin": "npm run build --workspace @adonisjs-lasagna/admin",
    "build:backup": "npm run build --workspace @adonisjs-lasagna/backup",
    "build:all": "npm run build && npm run build:sso && npm run build:billing && npm run build:admin && npm run build:backup",
    "typecheck": "npm run typecheck --workspace @adonisjs-lasagna/saas-tenancy",
    "typecheck:benchmarks": "npm run typecheck --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "lint": "eslint packages",
    "lint:fix": "eslint packages --fix",
    "test": "npm run test --workspace @adonisjs-lasagna/saas-tenancy",
    "test:coverage": "npm run test:coverage --workspace @adonisjs-lasagna/saas-tenancy",
    "test:integration": "npm run build:all && npm run test:integration:run --workspace @adonisjs-lasagna/saas-tenancy",
    "test:integration:coverage": "npm run build:all && npm run test:integration:coverage --workspace @adonisjs-lasagna/saas-tenancy",
    "coverage:report": "c8 report --temp-directory=coverage/.v8/all --reporter=lcov --reporter=text-summary",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "knip": "knip --no-exit-code",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "docs:sync": "node docs/scripts/sync-changelog.mjs",
    "docs:dev": "npm run docs:sync && vitepress dev docs",
    "docs:build": "npm run docs:sync && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --legacy-peer-deps",
    "release": "npm run build:all && changeset publish",
    "bench": "npm run bench --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:micro": "npm run bench:micro --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:db": "npm run bench:db --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:http": "npm run bench:http --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:mem": "npm run bench:mem --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:seed": "npm run bench:seed --workspace @adonisjs-lasagna/saas-tenancy-benchmarks --",
    "bench:report": "npm run bench:report --workspace @adonisjs-lasagna/saas-tenancy-benchmarks --",
    "bench:check": "npm run bench:check --workspace @adonisjs-lasagna/saas-tenancy-benchmarks --"
  },
  "prettier": "@adonisjs/prettier-config",
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@changesets/cli": "^2.27.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/eslint-config": "^2.0.0-beta.6",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/queue": "^0.6.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.0.0",
    "@japa/runner": "^4.2.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@types/luxon": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/opossum": "^8.1.9",
    "autoprefixer": "^10.5.0",
    "c8": "^10.1.3",
    "eslint": "^9.20.0",
    "gsap": "^3.15.0",
    "jose": "^5.10.0",
    "knip": "^5.0.0",
    "motion": "^12.38.0",
    "postcss": "^8.5.14",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.0",
    "stripe": "^18.0.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "~5.7",
    "vitepress": "^1.6.4"
  }
}
