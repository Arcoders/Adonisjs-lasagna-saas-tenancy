{
  "name": "@adonisjs-lasagna/saas-tenancy",
  "version": "0.2.2",
  "description": "SaaS multi-tenancy for AdonisJS 7 with pluggable isolation drivers (schema/database/row-scoping), connection pooling, circuit breaking, queues, and satellite features",
  "type": "module",
  "license": "MIT",
  "author": "Ismael Haytam Tanane",
  "homepage": "https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy.git"
  },
  "bugs": {
    "url": "https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy/issues"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "saas",
    "saas-tenancy",
    "multitenancy",
    "multi-tenant",
    "postgresql",
    "schema-based"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "examples/api"
  ],
  "files": [
    "build",
    "stubs"
  ],
  "exports": {
    ".": "./build/src/index.js",
    "./adapters": "./build/src/models/adapters/index.js",
    "./base-models": "./build/src/models/base/index.js",
    "./models/satellites": "./build/src/models/satellites/index.js",
    "./middleware": "./build/src/middleware/index.js",
    "./services": "./build/src/services/index.js",
    "./events": "./build/src/events/index.js",
    "./jobs": "./build/src/jobs/index.js",
    "./types": "./build/src/types/index.js",
    "./exceptions": "./build/src/exceptions/index.js",
    "./extensions/request": "./build/src/extensions/request.js",
    "./providers/multitenancy_provider": "./build/src/providers/multitenancy_provider.js",
    "./commands": "./build/src/commands/main.js",
    "./testing": "./build/src/testing/index.js",
    "./health": "./build/src/health/index.js",
    "./admin": "./build/src/admin/index.js"
  },
  "typesVersions": {
    "*": {
      "adapters": [
        "./build/src/models/adapters/index.d.ts"
      ],
      "base-models": [
        "./build/src/models/base/index.d.ts"
      ],
      "models/satellites": [
        "./build/src/models/satellites/index.d.ts"
      ],
      "middleware": [
        "./build/src/middleware/index.d.ts"
      ],
      "services": [
        "./build/src/services/index.d.ts"
      ],
      "events": [
        "./build/src/events/index.d.ts"
      ],
      "jobs": [
        "./build/src/jobs/index.d.ts"
      ],
      "types": [
        "./build/src/types/index.d.ts"
      ],
      "exceptions": [
        "./build/src/exceptions/index.d.ts"
      ],
      "extensions/request": [
        "./build/src/extensions/request.d.ts"
      ],
      "providers/multitenancy_provider": [
        "./build/src/providers/multitenancy_provider.d.ts"
      ],
      "commands": [
        "./build/src/commands/main.d.ts"
      ],
      "testing": [
        "./build/src/testing/index.d.ts"
      ],
      "health": [
        "./build/src/health/index.d.ts"
      ],
      "admin": [
        "./build/src/admin/index.d.ts"
      ]
    }
  },
  "adonisjs": {
    "configure": "./build/configure.js",
    "commands": [
      "./build/src/commands/main.js"
    ]
  },
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/commands/commands.json','build/src/commands/commands.json')\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx bin/test.ts",
    "test:coverage": "c8 --temp-directory=coverage/.v8/unit tsx bin/test.ts",
    "test:integration": "npm run build && tsx bin/test.integration.ts",
    "test:integration:coverage": "npm run build && c8 --check-coverage=false --temp-directory=coverage/.v8/integration tsx bin/test.integration.ts",
    "coverage:report": "c8 report --temp-directory=coverage/.v8/all --reporter=lcov --reporter=text-summary",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "knip": "knip --no-exit-code",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "docs:sync": "node docs/scripts/sync-changelog.mjs",
    "docs:dev": "npm run docs:sync && vitepress dev docs",
    "docs:build": "npm run docs:sync && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/drive": "^3.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/queue": "^0.6.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^7.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "better-sqlite3": "^11.0.0",
    "jose": "^5.0.0",
    "stripe": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/drive": {
      "optional": true
    },
    "@adonisjs/mail": {
      "optional": true
    },
    "@adonisjs/session": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "bentocache": "^1.0.0",
    "bullmq": "^5.0.0",
    "luxon": "^3.0.0",
    "opossum": "^9.0.0"
  },
  "prettier": "@adonisjs/prettier-config",
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/eslint-config": "^2.0.0-beta.6",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/queue": "^0.6.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.0.0",
    "@japa/runner": "^4.2.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@types/luxon": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/opossum": "^8.1.9",
    "autoprefixer": "^10.5.0",
    "c8": "^10.1.3",
    "eslint": "^9.20.0",
    "gsap": "^3.15.0",
    "jose": "^5.10.0",
    "knip": "^5.0.0",
    "motion": "^12.38.0",
    "postcss": "^8.5.14",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.0",
    "stripe": "^18.0.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "~5.7",
    "vitepress": "^1.6.4"
  }
}
