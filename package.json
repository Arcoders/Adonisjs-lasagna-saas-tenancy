{
  "name": "@adonisjs-lasagna/saas-tenancy-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @adonisjs-lasagna/saas-tenancy (core) and its satellite packages (sso, billing, admin, backup)",
  "type": "module",
  "license": "MIT",
  "author": "Ismael Haytam Tanane",
  "homepage": "https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy.git"
  },
  "bugs": {
    "url": "https://github.com/Arcoders/Adonisjs-lasagna-saas-tenancy/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/api",
    "benchmarks"
  ],
  "scripts": {
    "build": "npm run build --workspace @adonisjs-lasagna/saas-tenancy",
    "build:sso": "npm run build --workspace @adonisjs-lasagna/sso",
    "build:billing": "npm run build --workspace @adonisjs-lasagna/billing",
    "build:admin": "npm run build --workspace @adonisjs-lasagna/admin",
    "build:backup": "npm run build --workspace @adonisjs-lasagna/backup",
    "build:websockets": "npm run build --workspace @adonisjs-lasagna/websockets",
    "build:reporting": "npm run build --workspace @adonisjs-lasagna/reporting",
    "build:template": "npm run build --workspace @adonisjs-lasagna/satellite-template",
    "build:test-kit": "npm run build --workspace @adonisjs-lasagna/satellite-test-kit",
    "build:doc-coverage": "npm run build --workspace @adonisjs-lasagna/doc-coverage",
    "build:all": "npm run build && npm run build:sso && npm run build:billing && npm run build:admin && npm run build:backup && npm run build:websockets && npm run build:reporting && npm run build:template && npm run build:test-kit && npm run build:doc-coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages examples benchmarks",
    "lint:fix": "eslint packages examples benchmarks --fix",
    "test": "npm run test --workspace @adonisjs-lasagna/saas-tenancy",
    "test:integrity": "npm run test:integrity --workspace @adonisjs-lasagna/saas-tenancy",
    "test:docs-code": "npm run build:all && node scripts/check-docs-code.mjs",
    "test:coverage": "npm run test:coverage --workspace @adonisjs-lasagna/saas-tenancy",
    "test:integration": "npm run build:all && npm run test:integration:run --workspace @adonisjs-lasagna/saas-tenancy",
    "test:integration:coverage": "npm run build:all && npm run test:integration:coverage --workspace @adonisjs-lasagna/saas-tenancy",
    "test:fault": "npm run build:all && npm run test:fault:run --workspace @adonisjs-lasagna/saas-tenancy",
    "coverage:report": "c8 report --temp-directory=coverage/.v8/all --reporter=lcov --reporter=text-summary",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "check": "node scripts/check.mjs",
    "check:full": "npm run build:all && npm run check && node scripts/check-docs-code.mjs && npm run typecheck",
    "check:extension-contracts": "node scripts/check-extension-contracts.mjs",
    "check:doc-paths": "node scripts/check-doc-paths.mjs",
    "check:positioning": "node scripts/check-positioning.mjs",
    "check:japa-thunk": "node scripts/check-japa-thunk-contract.mjs",
    "scaffold:tests": "tsx scripts/scaffold_test_tree.ts",
    "knip": "knip --no-exit-code",
    "knip:deps": "knip --include dependencies",
    "audit:prod": "node scripts/audit-gate.mjs",
    "docs:doctor": "tsx packages/doc-coverage/bin/docs_doctor.ts",
    "check:doc-coverage": "node scripts/check-doc-coverage.mjs",
    "check:api-report": "node scripts/check-api-report.mjs",
    "docs:sync": "node docs/scripts/sync-changelog.mjs",
    "docs:clean": "node -e \"const{rmSync}=require('fs');rmSync('docs/.vitepress/cache',{recursive:true,force:true});rmSync('docs/.vitepress/dist',{recursive:true,force:true})\"",
    "docs:dev": "npm run docs:sync && vitepress dev docs",
    "docs:build": "npm run docs:sync && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --legacy-peer-deps",
    "release": "npm run build:all && changeset publish",
    "bench": "npm run bench --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:micro": "npm run bench:micro --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:db": "npm run bench:db --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:http": "npm run bench:http --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:isolation": "npm run bench:isolation --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:mem": "npm run bench:mem --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:soak": "npm run bench:soak --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:resilience": "npm run bench:resilience --workspace @adonisjs-lasagna/saas-tenancy-benchmarks",
    "bench:seed": "npm run bench:seed --workspace @adonisjs-lasagna/saas-tenancy-benchmarks --",
    "bench:report": "npm run bench:report --workspace @adonisjs-lasagna/saas-tenancy-benchmarks --",
    "bench:check": "npm run bench:check --workspace @adonisjs-lasagna/saas-tenancy-benchmarks --"
  },
  "prettier": "@adonisjs/prettier-config",
  "devDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/queue": "^0.6.0",
    "@adonisjs/redis": "^10.0.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@changesets/cli": "^2.27.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.0.0",
    "@japa/runner": "^4.2.0",
    "@microsoft/api-extractor": "^7.58.9",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@types/luxon": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/opossum": "^8.1.9",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.0",
    "c8": "^11.0.0",
    "eslint": "^10.0.0",
    "jose": "^6.0.0",
    "knip": "^5.0.0",
    "mermaid": "^11.4.1",
    "postcss": "^8.5.14",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.0",
    "stripe": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
