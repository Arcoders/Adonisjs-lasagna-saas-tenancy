{
  "title": "quickstart — npm install to a live tenant",
  "prompt": "✦ ",
  "cps": 50,
  "frames": [
    { "kind": "prompt" },
    { "kind": "type", "value": "npm install @adonisjs-lasagna/saas-tenancy" },
    { "kind": "wait", "ms": 350 },
    { "kind": "output", "value": "added 12 packages in 4s" },
    { "kind": "wait", "ms": 200 },
    { "kind": "prompt" },
    { "kind": "type", "value": "node ace configure @adonisjs-lasagna/saas-tenancy --with=audit,webhooks" },
    { "kind": "wait", "ms": 250 },
    { "kind": "output", "value": "  ✓ Registered MultitenancyProvider" },
    { "kind": "output", "value": "  ✓ Published config/multitenancy.ts" },
    { "kind": "output", "value": "  ✓ Scaffolded app/models/backoffice/tenant.ts" },
    { "kind": "output", "value": "  ✓ Published satellite migrations: audit, webhooks" },
    { "kind": "wait", "ms": 200 },
    { "kind": "prompt" },
    { "kind": "type", "value": "node ace backoffice:setup" },
    { "kind": "wait", "ms": 250 },
    { "kind": "output", "value": "  ✓ Created backoffice schema" },
    { "kind": "output", "value": "  ✓ Ran 7 satellite migrations" },
    { "kind": "wait", "ms": 200 },
    { "kind": "prompt" },
    { "kind": "type", "value": "node ace tenant:create \"Acme Corp\" \"admin@acme.example.com\"" },
    { "kind": "wait", "ms": 250 },
    { "kind": "output", "value": "  ✓ Inserted tenant 9c14f0a0-a96e-4d09-9a6f-1b28d6a4f0de" },
    { "kind": "output", "value": "  ✓ Queued InstallTenant — run `node ace queue:work` to provision" },
    { "kind": "wait", "ms": 200 },
    { "kind": "prompt" },
    { "kind": "type", "value": "node ace queue:work &" },
    { "kind": "wait", "ms": 250 },
    { "kind": "output", "value": "  [worker] processing InstallTenant for tenant 9c14f0a0…" },
    { "kind": "output", "value": "  [worker] CREATE SCHEMA \"tenant_9c14f0a0…\"" },
    { "kind": "output", "value": "  [worker] migrating tenant schema (3 batches)" },
    { "kind": "output", "value": "  [worker] InstallTenant complete in 1.4s" },
    { "kind": "wait", "ms": 200 },
    { "kind": "prompt" },
    { "kind": "type", "value": "node ace tenant:doctor" },
    { "kind": "wait", "ms": 250 },
    { "kind": "output", "value": "  schema_drift          ✓ all tenants in sync" },
    { "kind": "output", "value": "  migrations            ✓ 1 tenant up to date" },
    { "kind": "output", "value": "  circuit_breakers      ✓ all CLOSED" },
    { "kind": "output", "value": "  queues                ✓ healthy (0 stalled)" },
    { "kind": "output", "value": "  backups               ⚠ 1 tenant never backed up" },
    { "kind": "output", "value": "  provisioning_stalled  ✓ none" },
    { "kind": "output", "value": "  failed_tenants        ✓ none" },
    { "kind": "output", "value": "  replica_lag           ✓ 0.2s" },
    { "kind": "output", "value": "" },
    { "kind": "output", "value": "  Lasagna: 1 tenant, 1 warning. Run with --fix to auto-recover." }
  ]
}
